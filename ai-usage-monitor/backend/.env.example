# Copy this file to .env and fill in real values for your deployment.
# Locally, the defaults baked into app/core/config.py are enough to run
# the app with no .env file at all.

APP_NAME="AI Usage Monitor"
ENVIRONMENT=development

# PostgreSQL is preferred. If this is unreachable, the app falls back to
# a local SQLite file automatically -- see app/core/database.py.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_usage_monitor

# Comma-separated list of frontend origins allowed to call this API.
# Required on Render/any host once the frontend is deployed somewhere
# other than localhost -- the deployed frontend's exact origin (scheme +
# host, no trailing slash, no path) must be listed here or every request
# from it fails CORS preflight. A Vercel preview deployment gets its own
# random subdomain and needs adding here too if you want preview builds
# to reach the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://vict-ai.vercel.app

PROMPT_MONITORING_ENABLED=true
PROMPT_MONITORING_DISABLED_ASSETS=
PROMPT_LOG_RETENTION_DAYS=30

DEMO_MODE=true
ACCESS_CONTROL_ENABLED=false
MONITOR_API_KEY=demo-ai-monitor-key
