# Copy to .env.local for local overrides, or set in Vercel under
# Project Settings -> Environment Variables for the deployed site.
#
# IMPORTANT: Vite only inlines this at BUILD time. Setting/changing it in
# Vercel does nothing to an already-deployed site -- you must trigger a
# new deployment (Deployments -> ... -> Redeploy) after adding or
# changing it for the live site to pick it up.
#
# If unset, the app falls back to the deployed Render backend
# (see src/App.jsx) rather than localhost, so a build without this set
# still points somewhere real.
VITE_API_URL=http://localhost:8000
